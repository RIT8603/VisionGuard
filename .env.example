# VisionGuard AI — environment overrides
#
# Copy to `.env` and edit. Values here override configs/config.yaml;
# CLI flags override both.
#
# Every name also works with a VISIONGUARD_ prefix
# (VISIONGUARD_VIDEO_SOURCE and VIDEO_SOURCE are equivalent; the prefixed
# form wins and is safer in shared environments).

# ---- which config file to load ----
# VISIONGUARD_CONFIG=configs/config.yaml

# ---- development: webcam ----
VIDEO_SOURCE=webcam
VIDEO_DEVICE_ID=0
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30

# ---- evaluation: video file (Phase 4) ----
# VIDEO_SOURCE=file
# VIDEO_PATH=data/samples/office.mp4
# VIDEO_LOOP=true

# ---- production: RTSP camera (Phase 5) ----
# Nothing else changes: the same modules and the same pipeline run unmodified.
# VIDEO_SOURCE=rtsp
# RTSP_URL=rtsp://user:password@192.168.1.64:554/Streaming/Channels/101
# RTSP_TRANSPORT=tcp

# ---- processing ----
# TARGET_WIDTH=960
# SHOW_WINDOW=true
# MIRROR=false
# MAX_FPS=0

# ---- logging ----
LOG_LEVEL=INFO
# LOG_FILE=logs/visionguard.log

# ---- dashboard ----
# DASHBOARD=true
# DASHBOARD_HOST=127.0.0.1
# Required whenever DASHBOARD_HOST is not localhost (a random one is generated
# per run if unset). 16+ characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# VISIONGUARD_DASHBOARD_TOKEN=
# DASHBOARD_ALLOWED_HOSTS=guard.lan,192.168.1.20
