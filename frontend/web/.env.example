# VisionGuard web portal - server-side settings for the help assistant.
#
# Local dev: copy to .env.local (git-ignored) and fill in. On Vercel, set these
# as Project Environment Variables instead. None of these has a VITE_ prefix,
# so Vite never exposes them to the browser - keep it that way.

# Which provider answers. Unset = the assistant shows as unavailable.
# Supported: openrouter
ASSISTANT_PROVIDER=openrouter

# Required: the OpenRouter model id, e.g. provider/model-name from
# https://openrouter.ai/models. No default - the assistant stays unavailable
# until a model is chosen, so the price is always an explicit decision.
ASSISTANT_MODEL=

# --- openrouter ---
OPENROUTER_API_KEY=
