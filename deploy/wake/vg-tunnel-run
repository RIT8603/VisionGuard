#!/bin/sh
# SSH tunnel to the GPU backend, started by vg-backend-tunnel.service.
# The backend's public IP changes on every EC2 start; vgwake writes the
# current one to the host file. The host key is pinned under a fixed alias,
# so a new address never means trusting a new key.
set -eu
HOST_FILE=/var/lib/vgwake/backend_host
HOST=$(cat "$HOST_FILE" 2>/dev/null || true)
if ! printf '%s' "$HOST" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
  echo "backend is not running (no address in $HOST_FILE); waiting"
  sleep 20
  exit 1
fi
exec /usr/bin/ssh -N -T \
  -o BatchMode=yes -o IdentitiesOnly=yes -o IdentityFile=/home/ubuntu/.ssh/vg_tunnel \
  -o StrictHostKeyChecking=yes -o HostKeyAlias=vg-backend \
  -o UserKnownHostsFile=/home/ubuntu/.ssh/vg_backend_known_hosts \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3 \
  -o ConnectTimeout=10 \
  -L 127.0.0.1:8080:127.0.0.1:8080 "vgtunnel@$HOST"
