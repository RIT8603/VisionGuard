[Unit]
Description=VisionGuard AI backend and camera workers
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/visionguard
EnvironmentFile=/etc/visionguard.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/home/ubuntu
ExecStart=/opt/visionguard/venv/bin/python -m backend.main --config /opt/visionguard/deploy/runtime/config.yaml --dashboard --dashboard-host 0.0.0.0 --dashboard-port 8080 --no-window
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=60
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
